# Environment Configuration Example
# Copy to .env and configure for development / staging / production

# Application Ports
PORT=4000
FRONTEND_PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruitment_db?schema=public"

# Redis Configuration (BullMQ queues & caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET="replace-with-a-very-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="1d"
SESSION_SECRET="replace-with-secure-session-secret-key-minimum-32-characters"
COOKIE_SECRET="replace-with-secure-cookie-secret-key"
CORS_ORIGIN="http://localhost:3000"

# Super Admin Initial Provisioning (used during db:seed)
INITIAL_SUPERADMIN_EMAIL="admin@enterprise.com"
INITIAL_SUPERADMIN_PASSWORD="AdminSecurePassword123!@#"
INITIAL_SUPERADMIN_NAME="System Super Administrator"

# Meta WhatsApp Business Cloud API
META_WA_PHONE_NUMBER_ID=""
META_WA_BUSINESS_ACCOUNT_ID=""
META_WA_ACCESS_TOKEN=""
META_WA_API_VERSION="v18.0"
META_WA_WEBHOOK_VERIFY_TOKEN=""
META_WA_APP_SECRET=""

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_FROM="HR Recruitment Team <recruitment@enterprise.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Document Storage (Cloudinary or S3-compatible private storage)
STORAGE_DRIVER="local" # "local" | "s3" | "cloudinary"
STORAGE_LOCAL_DIR="./uploads"

# AWS / MinIO S3 (if STORAGE_DRIVER="s3")
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_FORCE_PATH_STYLE="false"

# Cloudinary (if STORAGE_DRIVER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
